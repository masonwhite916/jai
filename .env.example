# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# On Railway: add a Postgres plugin and this is set automatically.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Server ────────────────────────────────────────────────────────────────────
# TCP port the API server listens on.
# On Railway: set automatically. Locally: any free port.
PORT=8080

# Log verbosity. One of: trace | debug | info | warn | error | fatal
# Defaults to "info" if unset.
LOG_LEVEL=info

# ── Admin panel ───────────────────────────────────────────────────────────────
# Password for the JAI Admin dispatch panel.
# Choose a strong random string — this is the only credential protecting admin access.
ADMIN_PASSWORD=change-me

# ── OTP / SMS (Taqnyat) ───────────────────────────────────────────────────────
# Taqnyat is the active OTP provider. All three variables are required.
TAQNYAT_BEARER_TOKEN=your-taqnyat-bearer-token
# The sender name that appears on the SMS (must be pre-approved by Taqnyat).
TAQNYAT_SENDER=JAI
# Language code for the OTP message body. e.g. "ar" (Arabic) or "en" (English).
TAQNYAT_LANG=ar

# ── Technician signup gate ────────────────────────────────────────────────────
# Secret invite code required to register a new technician account.
# Fail-closed: if this variable is not set, technician signup is completely disabled.
# Leave unset in production until you are ready to onboard technicians.
TECHNICIAN_INVITE_CODE=

# ── Whop membership plans ─────────────────────────────────────────────────────
# Whop plan IDs for each membership tier.
# Find these in your Whop dashboard under Products → Plans.
WHOP_PLAN_BASIC=plan_xxxxxxxxxxxxxxxx
WHOP_PLAN_ACCIDENTS=plan_xxxxxxxxxxxxxxxx
WHOP_PLAN_RENTAL=plan_xxxxxxxxxxxxxxxx

# ── Legacy / unused ───────────────────────────────────────────────────────────
# Twilio was the original OTP provider but has been replaced by Taqnyat.
# These variables are no longer called in production code. Safe to omit.
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# ── Replit-only (do not set on Railway) ──────────────────────────────────────
# These are injected automatically by Replit's connector proxy for the Whop
# integration. They do not exist outside of Replit and should not be set manually.
# REPL_IDENTITY=
# REPLIT_CONNECTORS_HOSTNAME=
# WEB_REPL_RENEWAL=
