{
  "expo": {
    "name": "JAI Roadside Assistance",
    "slug": "jai-app",
    "version": "1.0.0",
    "description": "Instant roadside assistance in Riyadh. Request towing, flat tyre help, jump-start, fuel delivery and more — track your technician in real time.",
    "privacy": "https://jaiksa.replit.app/jai-web/privacy",
    "primaryColor": "#2D1B69",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jai-app",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D1B69"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jai.roadside"
    },
    "android": {
      "package": "com.jai.roadside",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#2D1B69"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "jaiksa.replit.app" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#2D1B69",
      "barStyle": "light-content",
      "translucent": false
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/c2f8bd92-6111-4050-a3d4-6a6b86c18291",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-updates",
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2D1B69",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "JAI Roadside"
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JAI uses your location to send roadside help exactly where you are."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "JAI needs access to your photos so you can attach pictures of the vehicle issue."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
